<?xml version="1.0" ?>
<sdf version="1.7">
    <model name="rock_a">
        <pose>0 0 0 0 0 0</pose>

        <static>false</static>

        <link name="rock">

            <!-- visual model-->
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>model://rock_a/meshes/Rock_A.stl</uri>
                    </mesh>
                </geometry>
                
                <material>
                    <ambient>0.8 0.8 0.8 1</ambient>
                    <diffuse>0.8 0.8 0.8 1</diffuse>
                    <specular>0.8 0.8 0.8 1</specular>
                </material>
            </visual>

            <!-- collision geometry-->
            <collision name="collision">
                <geometry>
                    <!-- Replaced complex .stl mesh with a simple primitive -->
                    <sphere>
                        <radius>0.19</radius> 
                    </sphere>
                </geometry>
            </collision>

            <inertial>
                <mass>1</mass>
                <inertia>
                <ixx>0.0002</ixx>
                <iyy>0.0002</iyy>
                <izz>0.0002</izz>
                </inertia>
            </inertial>
        </link>
    </model>
</sdf>