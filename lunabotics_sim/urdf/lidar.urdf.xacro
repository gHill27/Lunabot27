<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="sick_tim781s" params="name parent *origin">

    <!-- Mounting Joint -->
    <joint name="${name}_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="${name}_link" />
    </joint>

    <!-- Physical Base Link -->
    <link name="${name}_link">
      <visual>
        <!-- Placeholder primitive. For the official mesh, clone 'sick_scan_xd' and replace this with: 
             <mesh filename="package://sick_scan_xd/meshes/sick_tim.stl" /> -->
        <origin xyz="0 0 0.043" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.03" length="0.086"/>
        </geometry>
        <material name="dark_grey">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.043" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.035" length="0.090"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.043" rpy="0 0 0" />
        <mass value="0.250" /> <!-- Actual TiM781S weight is ~250g -->
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
      </inertial>
    </link>

    <!-- Optical Emission Joint & Link -->
    <!-- The actual laser pulses exit ~60mm above the base mount -->
    <joint name="${name}_optical_joint" type="fixed">
      <origin xyz="0 0 0.06" rpy="0 0 0" />
      <parent link="${name}_link" />
      <child link="${name}_optical_link" />
    </joint>
    <link name="${name}_optical_link" />

    <!-- Gazebo Sim (Ignition) Sensor Plugin -->
    <gazebo reference="${name}_link">
      <sensor name="${name}" type="gpu_lidar">
        <topic>/scan</topic>
        <update_rate>15.0</update_rate>
        <gz_frame_id>${name}_optical_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>811</samples> <!-- 270 deg / 0.33 deg resolution -->
              <resolution>1</resolution>
              <min_angle>-2.35619</min_angle> <!-- -135 degrees -->
              <max_angle>2.35619</max_angle>  <!-- +135 degrees -->
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>25.0</max>
            <resolution>0.001</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev> <!-- Typical 10mm statistical error -->
          </noise>
        </lidar>
        <always_on>1</always_on>
        <visualize>true</visualize>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>