<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Reusable Orbbec Astra camera macro -->
  <xacro:macro name="astra" params="parent name:=camera *origin">

    <!-- Mount camera body to parent link (e.g., base_link) -->
    <joint name="${name}_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${name}_link"/>
    </joint>

    <!-- Physical Orbbec Astra camera body (40mm D x 165mm W x 30mm H, ~300g) -->
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.04 0.165 0.03"/>
        </geometry>
        <material name="orbbec_astra_black">
          <color rgba="0.15 0.15 0.15 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.04 0.165 0.03"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.30"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.000703" ixy="0.0" ixz="0.0"
                 iyy="0.000063" iyz="0.0"
                 izz="0.000721"/>
      </inertial>
    </link>

    <!-- Depth sensor frame and optical frame -->
    <joint name="${name}_depth_joint" type="fixed">
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <parent link="${name}_link"/>
      <child link="${name}_depth_frame"/>
    </joint>
    <link name="${name}_depth_frame"/>

    <joint name="${name}_depth_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
      <parent link="${name}_depth_frame"/>
      <child link="${name}_depth_optical_frame"/>
    </joint>
    <link name="${name}_depth_optical_frame"/>

    <!-- RGB color sensor frame (25mm baseline offset) and optical frame -->
    <joint name="${name}_color_joint" type="fixed">
      <origin xyz="0.0 -0.025 0.0" rpy="0 0 0"/>
      <parent link="${name}_link"/>
      <child link="${name}_color_frame"/>
    </joint>
    <link name="${name}_color_frame"/>

    <joint name="${name}_color_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
      <parent link="${name}_color_frame"/>
      <child link="${name}_color_optical_frame"/>
    </joint>
    <link name="${name}_color_optical_frame"/>

  <gazebo reference="${name}_link">
    <sensor name="${name}_rgbd" type="rgbd_camera">
      <!-- Tells Gazebo to use the Z-forward optical frame for point clouds -->
      <gz_frame_id>${name}_depth_optical_frame</gz_frame_id>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <!-- The leading slash forces the topic to the root: /orbbec_camera -->
      <topic>/${name}</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>50</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>

  </xacro:macro>
</robot>